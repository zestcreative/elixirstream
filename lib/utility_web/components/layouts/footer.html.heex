<footer class="max-w-screen-xl mx-auto py-12 px-4 sm:px-6 md:flex md:items-center md:justify-between lg:px-8">
  <div class="flex place-items-center justify-center md:order-2 block print:hidden">
    <Components.outbound_link href="https://bsky.app/profile/david.bernheisel.com" title="Bluesky" class="ml-6 text-gray-400 hover:text-gray-500">
      <span class="sr-only">Bluesky</span>
      <Icon.bluesky class="h-6 w-6" />
    </Components.outbound_link>
    <Components.outbound_link href="https://github.com/zestcreative/utility" title="GitHub" class="ml-6 text-gray-400 hover:text-gray-500">
      <span class="sr-only">GitHub</span>
      <Icon.github class="h-6 w-6" />
    </Components.outbound_link>
  </div>

  <div class="mt-8 md:mt-0 md:order-1">
    <p class="text-center text-base leading-6 text-gray-400">
      &copy; <%= Date.utc_today().year %> Zest Creative, LLC <span class="hidden print:inline">bernheisel.com</span>
    </p>
  </div>
</footer>
