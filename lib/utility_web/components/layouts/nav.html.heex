<header class="sticky top-0 z-30 bg-[#0c0a12]/90 backdrop-blur border-b border-[#241b39]">
  <div class="max-w-6xl mx-auto px-5 h-14 flex items-center gap-4 sm:gap-6 font-mono">
    <div class="flex items-center shrink-0">
      <.link navigate={~p"/regex"} class="flex items-center gap-1.5 select-none">
        <img src={~p"/images/logo.svg"} class="w-6 h-6" alt="Elixir Stream" />
        <span class="font-brand font-extrabold text-white text-lg tracking-tight">elixir<span class="text-brand-400">·</span>stream</span>
      </.link>
    </div>
    <nav class="flex items-center gap-1 text-[13px] flex-wrap">
      <.link navigate={~p"/regex"} class={"px-3 py-1.5 rounded-md #{if @active_tab == :regex, do: "text-white bg-brand-500/15 ring-1 ring-brand-500/40", else: "text-zinc-400 hover:text-white hover:bg-white/5"}"}>regex</.link>
      <.link navigate={~p"/sink"} class={"px-3 py-1.5 rounded-md #{if @active_tab == :sink, do: "text-white bg-brand-500/15 ring-1 ring-brand-500/40", else: "text-zinc-400 hover:text-white hover:bg-white/5"}"}>sink</.link>
      <.link navigate={~p"/gendiff"} class={"px-3 py-1.5 rounded-md #{if @active_tab == :gendiff, do: "text-white bg-brand-500/15 ring-1 ring-brand-500/40", else: "text-zinc-400 hover:text-white hover:bg-white/5"}"}>gendiff</.link>
      <.link navigate={~p"/about"} class={"px-3 py-1.5 rounded-md #{if @active_tab == nil, do: "text-white bg-brand-500/15 ring-1 ring-brand-500/40", else: "text-zinc-400 hover:text-white hover:bg-white/5"}"}>about</.link>
    </nav>
    <div class="ml-auto text-xs text-zinc-400 hidden sm:block">iex(1)&gt; <span class="text-accent-400">▊</span></div>
  </div>
</header>
