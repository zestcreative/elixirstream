<Components.page_panel title="Generator Diffs" id="gendiff">
  <:description>
    Diff the output of <code class="text-accent-400">mix</code> project generators across versions and flags — see exactly what an upgrade changes.
  </:description>
  <:titlebar>
    generator.exs
    <%= submit form: "gen-diff",
      class: "ml-auto flex items-center gap-1 px-2.5 py-1 rounded-md transition text-white bg-brand-500 hover:bg-brand-400 disabled:cursor-not-allowed disabled:opacity-50", id: "submit-diff", disabled: @building && !@finished_building do %>
      <Icon.diff class="w-3 h-3" /> Generate Diff
    <% end %>
  </:titlebar>
  <:content>
    <.form
      :let={f}
      for={@changeset}
      id="gen-diff"
      aria-labelledby="gendiff-title"
      phx-submit="diff"
      phx-change="validate"
      phx-hook="HandleScroll"
      class="space-y-6 font-mono"
    >
      <div>
        <%= label f, :project, class: "flex items-center gap-2 text-xs text-zinc-400 mb-1.5" do %>
          project
          <%= if @project_url do %>
            <a rel="nofollow" target="_blank" href={@project_url} class="text-accent-400 hover:text-accent-300 lowercase">
              {Phoenix.Naming.humanize(@project_source)}
            </a>
          <% end %>
        <% end %>
        {select(f, :project, generator_package_options(),
          autocomplete: "off",
          class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm py-2.5 px-3"
        )}
        <Components.errors form={f} field={:project} />
      </div>

      <div>
        <%= label f, :command, class: "flex items-center gap-2 text-xs text-zinc-400 mb-1.5" do %>
          command
          <%= if @docs_url do %>
            <a rel="nofollow" target="_blank" href={@docs_url} class="text-accent-400 hover:text-accent-300 lowercase">
              docs
            </a>
          <% end %>
        <% end %>
        {select(f, :command, generator_options(@project),
          autocomplete: "off",
          class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm py-2.5 px-3"
        )}
        <Components.errors form={f} field={:command} />
        <%= if @command_help do %>
          <p class="mt-2 text-sm text-zinc-400">
            {@command_help}
          </p>
        <% end %>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          {label(f, :from_version, "from version", class: "block text-xs text-zinc-400 mb-1.5")}
          {select(f, :from_version, version_options(@from_versions),
            autocomplete: "off",
            placeholder: "From version...",
            class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm py-2.5 px-3"
          )}
          <Components.errors form={f} field={:from_version} />
        </div>

        <div>
          {label(f, :to_version, "to version", class: "block text-xs text-zinc-400 mb-1.5")}
          {select(f, :to_version, version_options(@to_versions),
            autocomplete: "off",
            placeholder: "To version...",
            class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm py-2.5 px-3"
          )}
          <Components.errors form={f} field={:to_version} />
        </div>
      </div>

      <% is_flags_hidden = !Enum.any?(@available_from_flags ++ @available_to_flags) %>
      <div class={"grid grid-cols-1 md:grid-cols-2 gap-3 #{if is_flags_hidden, do: "hidden"}"}>
        <div>
          {label(f, :from_flags, "from #{@from_version} flags", class: "block text-xs text-zinc-400 mb-1.5")}
          {multiple_select(f, :from_flags, @available_from_flags,
            class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm overflow-y-hidden",
            size: length(@available_from_flags)
          )}
          <Components.errors form={f} field={:from_flags} />
        </div>

        <div>
          {label(f, :to_flags, "to #{@to_version} flags", class: "block text-xs text-zinc-400 mb-1.5")}
          {multiple_select(f, :to_flags, @available_to_flags,
            class: "w-full rounded-lg bg-[#0c0a12] ring-1 ring-[#241b39] focus:ring-brand-500 border-0 text-white text-sm overflow-y-hidden",
            size: length(@available_to_flags)
          )}
          <Components.errors form={f} field={:to_flags} />
        </div>
      </div>

      <%= if @command && is_flags_hidden do %>
        <p class="text-sm text-zinc-400">No flags for generator</p>
      <% end %>
    </.form>

    <div id="runners"></div>

    <%= if @building do %>
      <div class="mt-10 rounded-xl overflow-hidden border border-[#241b39] bg-[#0c0a12] font-mono text-xs shadow-[0_0_60px_-15px_rgba(148,40,236,0.5)]">
        <%!-- window titlebar --%>
        <div class="flex items-center gap-2 px-4 h-9 border-b border-[#241b39] bg-black/40 text-[11px] text-zinc-400">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-brand-500"></span>
            <span class="w-3 h-3 rounded-full bg-accent-400"></span>
            <span class="w-3 h-3 rounded-full bg-zinc-600"></span>
          </span>
          <span>gendiff — build</span>
          <%= unless @finished_building do %>
            <Icon.gear class="ml-auto w-4 h-4 animate-spin text-accent-400" />
          <% end %>
        </div>

        <%!-- pane 0: setup (top, full width) --%>
        <div class="flex flex-col">
          <div class="px-2 py-0.5 text-[10px] text-zinc-500 bg-black/40 border-b border-zinc-800">
            0 &mdash; setup
          </div>
          <div class="p-2 overflow-auto max-h-48" id="output-main" phx-update="stream" phx-hook="AutoScroll">
            <span :for={{dom_id, entry} <- @streams.lines_main} id={dom_id}>
              {raw(entry.line)}
            </span>
          </div>
        </div>

        <%!-- horizontal split: pane 1 (from) | pane 2 (to) --%>
        <div class="grid grid-cols-1 md:grid-cols-2 border-t border-zinc-700">
          <div class="flex flex-col border-b md:border-b-0 md:border-r border-zinc-700">
            <div class="px-2 py-0.5 text-[10px] text-zinc-500 bg-black/40 border-b border-zinc-800">
              1 &mdash; mix {@command} <span class="text-brand-400">{@from_version}</span>
            </div>
            <div class="p-2 overflow-auto max-h-64" id="output-runner-1" phx-update="stream" phx-hook="AutoScroll">
              <span :for={{dom_id, entry} <- @streams.lines_1} id={dom_id}>
                {raw(entry.line)}
              </span>
            </div>
          </div>

          <div class="flex flex-col">
            <div class="px-2 py-0.5 text-[10px] text-zinc-500 bg-black/40 border-b border-zinc-800">
              2 &mdash; mix {@command} <span class="text-accent-400">{@to_version}</span>
            </div>
            <div class="p-2 overflow-auto max-h-64" id="output-runner-2" phx-update="stream" phx-hook="AutoScroll">
              <span :for={{dom_id, entry} <- @streams.lines_2} id={dom_id}>
                {raw(entry.line)}
              </span>
            </div>
          </div>
        </div>

        <%!-- tmux status bar --%>
        <div class="flex items-center gap-2 text-[11px] text-green-950 bg-green-600">
          <span class="px-2 py-0.5 font-bold bg-green-800 text-green-100">{@project}</span>
          <span class="flex-1">
            0:setup 1:{@from_version} 2:{@to_version}<span class="font-bold">*</span>
          </span>
          <span class="px-2 py-0.5 bg-green-800 text-green-100">
            {if @finished_building, do: "done", else: "building…"}
          </span>
        </div>
      </div>
    <% end %>
  </:content>
</Components.page_panel>
